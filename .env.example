# Convex
# Convex deployment name
CONVEX_DEPLOYMENT=
# Convex deployment URL (required)
VITE_CONVEX_URL=

# Site URL of the app (also set as SITE_URL in the Convex deployment)
BETTER_AUTH_URL=http://localhost:3000
# VITE_CONVEX_SITE_URL is the Convex HTTP actions URL (.convex.site)
VITE_CONVEX_SITE_URL=
# Optional: comma-separated hosts besides localhost that Git providers may use over plain http (tests only); set the same list as HTTP_PROVIDER_HOSTS in the Convex deployment
VITE_HTTP_PROVIDER_HOSTS=
# Set in the Convex deployment, not here: npx convex env set <NAME> <value>
#   BETTER_AUTH_SECRET, SITE_URL, HTTP_PROVIDER_HOSTS (optional)
